{
  "name": "lawscape",
  "version": "0.6.0",
  "private": true,
  "description": "A browser-based legal ethics RPG.",
  "type": "module",
  "scripts": {
    "prebuild": "npm run rules:build && npm run mpre:build && npm run sqe:build && npm run states:build && node scripts/build-guides.mjs",
    "build": "node scripts/build.mjs && node scripts/package-site.mjs",
    "check": "node scripts/check.mjs",
    "release:check": "node scripts/check-release.mjs",
    "mpre:build": "node scripts/build-mpre-questions.mjs",
    "sqe:build": "node scripts/build-sqe-questions.mjs",
    "rules:build": "node scripts/build-rule-library.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs && npm run check",
    "states:build": "node scripts/build-state-questions.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "browser-game",
    "legal-education",
    "legal-ethics",
    "rpg",
    "javascript"
  ]
}
